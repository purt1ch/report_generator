# Скопируйте этот файл как .env и подставьте свои значения.
# Файл .env находится в .gitignore и не должен попадать в репозиторий.

# Ключ Google Gemini из https://aistudio.google.com/apikey
GEMINI_API_KEY2=

# Адрес API. Прямой доступ к Gemini из России может быть заблокирован,
# в этом случае укажите адрес своего прокси.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Название модели. Значение по умолчанию — алиас стороннего прокси;
# для официального адреса выше укажите настоящее, например:
# AI_MODEL=gemini-2.5-flash
# AI_MODEL=gemini-3.1-flash-lite
